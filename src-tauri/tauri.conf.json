{
  "build": {
    "beforeDevCommand": "webpack --config webpack.tauri.config.js",
    "beforeBuildCommand": "",
    "frontendDist": "../src-app"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "MP3 Chapter Player",
  "mainBinaryName": "MP3 Chapter Player",
  "version": "0.4.0",
  "identifier": "com.mp3chapters.player",
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "filename",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "assetProtocol": {
        "scope": [
          "$HOME/*",
          "$DESKTOP/*",
          "$DOCUMENT/*",
          "$DOWNLOAD/*",
          "$PUBLIC/*",
          "$VIDEO/*"
        ],
        "enable": true
      },
      "csp": null
    }
  }
}