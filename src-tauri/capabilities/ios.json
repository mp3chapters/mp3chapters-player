{
  "identifier": "ios-capability",
  "platforms": [
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read-recursive",
    "core:window:default",
    "core:window:allow-set-title",
    "core:event:default"
  ]
}
