{
  "identifier": "ios-capability",
  "platforms": [
    "iOS",
    "android"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-appdata-read-recursive",
    "core:window:default",
    "core:event:default",
    "shell:allow-open"
  ]
}
