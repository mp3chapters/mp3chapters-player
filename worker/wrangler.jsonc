{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mp3chapters-podcast-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "PODCAST_RATE_LIMITER",
      "namespace_id": "935774",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
